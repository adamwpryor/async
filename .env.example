# .env.example
# Zero-Trust configuration: Do NOT hardcode secrets. Copy this file to .env and populate.

# Google API Key for Google Embeddings
GOOGLE_API_KEY="your_google_api_key_here"

# Supabase vector database configuration
SUPABASE_URL="http://127.0.0.1:54421"
SUPABASE_KEY="your_supabase_service_role_key_here"

# Optional: HuggingFace token for downloading gated models. 
# It is recommended to use `huggingface-cli login` in your terminal instead of setting this.
# HF_TOKEN="your_huggingface_token_here"
